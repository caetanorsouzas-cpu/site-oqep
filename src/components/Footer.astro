---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.svg';
import { agency } from '../data/site';
---

  <footer class="page page--dark foot">
    <div class="wrap foot__in">
      <Image src={logo} alt="" width={72} height={72} />
      <p>
        <strong class="label">{agency.name}</strong><br />
        {agency.descriptor}<br />
        {agency.city} · desde 2021 · atendimento no Brasil inteiro
      </p>
    </div>
    <div class="wrap foot__legal">
      <p>
        {agency.name} © {new Date().getFullYear()} - Todos os direitos reservados - CNPJ: 41.963.234/0001-11 | Site construído por{' '}
        <a href="https://www.instagram.com/ca3tano_ramos/" target="_blank" rel="noopener">Caetano&nbsp;Ramos</a>
      </p>
    </div>
  </footer>

<style>
  /* Footer */
  .foot {
    padding-block: 3rem;
  }

  .foot__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem 2rem;
  }

  .foot__in :global(img) {
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--white);
  }

  .foot__in p {
    color: var(--cream);
    line-height: 1.5;
  }

  .foot__in strong {
    color: var(--white);
    font-size: 1.1rem;
  }

  /* Legal line at the very bottom */
  .foot__legal {
    margin-top: 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .foot__legal p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--cream);
  }

  .foot__legal a {
    color: var(--white);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
</style>
