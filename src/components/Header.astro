---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/brand/logo.svg';
import { primaryContact } from '../data/site';

interface Props {
  current?: 'home' | 'blog';
}
const { current = 'home' } = Astro.props;
const home = current === 'home';
const base = home ? '' : '/';
---

  <a class="skip" href="#conteudo">Pular para o conteúdo</a>

  <header class="top">
    <div class="wrap top__in">
      <a class="top__brand" href={home ? "#inicio" : "/"} aria-label="O Que Eu Postaria? Início">
        <Image src={logo} alt="" width={44} height={44} loading="eager" />
        <span class="top__name">
          <span class="label">O Que Eu Postaria?</span>
          <span class="top__desc">Agência de Comunicação e Marketing</span>
        </span>
      </a>
      <button class="top__menu" type="button" aria-expanded="false" aria-controls="top-nav" aria-label="Abrir menu">
        <span class="top__menu-open"><Icon name="menu" /></span>
        <span class="top__menu-close"><Icon name="close" /></span>
      </button>
      <nav class="top__nav" id="top-nav" aria-label="Seções">
        <a href={`${base}#album`}>Trabalhos</a>
        <a href={`${base}#servicos`}>Serviços</a>
        <a href={`${base}#time`}>Time</a>
        <a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>Blog</a>
        <a href={`${base}#contato`}>Contato</a>
      </nav>
      <a class="btn btn--foil top__cta" href={primaryContact.whatsapp} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        <span>WhatsApp</span>
      </a>
    </div>
  </header>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.7rem 1rem;
    background: var(--foil);
    color: var(--ink);
    font-weight: 800;
    border-radius: 0.4rem;
  }

  .skip:focus {
    top: 1rem;
  }

  /* Header strip */
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--terra);
    color: var(--white);
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }

  .top__in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.25rem;
  }

  .top__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    margin-right: auto;
  }

  .top__brand :global(img) {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--white);
  }

  .top__name {
    display: grid;
    line-height: 1.1;
  }

  .top__name .label {
    font-size: 1.05rem;
  }

  .top__desc {
    font-size: 0.78rem;
    color: var(--terra-tint);
  }

  .top__nav {
    display: flex;
    gap: 1.6rem;
    font-weight: 700;
  }

  .top__nav a {
    text-decoration: none;
    padding-block: 0.4rem;
    background: linear-gradient(currentColor 0 0) left bottom / 0 2px no-repeat;
    transition: background-size 0.3s var(--ease-out);
  }

  .top__nav a:hover {
    background-size: 100% 2px;
  }

  .top__cta {
    min-height: 2.75rem;
    padding: 0.6rem 1.1rem;
  }

  .top__menu {
    display: none;
  }

  /* Phones and tablets: links fold into a panel under the strip */
  @media (max-width: 56rem) {
    .top__in {
      gap: 0.6rem;
    }

    .top__menu {
      order: 3;
      display: grid;
      place-items: center;
      width: 2.9rem;
      height: 2.9rem;
      padding: 0;
      border: 1.5px solid rgb(255 255 255 / 0.5);
      border-radius: 0.5rem;
      background: transparent;
      color: var(--white);
      cursor: pointer;
    }

    .top__menu :global(svg) {
      width: 1.4rem;
      height: 1.4rem;
    }

    .top__menu-close,
    .top[data-open] .top__menu-open {
      display: none;
    }

    .top[data-open] .top__menu-close {
      display: contents;
    }

    .top__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0.4rem var(--gutter) 1rem;
      background: var(--terra);
      border-bottom: 1px solid rgb(255 255 255 / 0.16);
      box-shadow: 0 1.2rem 1.6rem -0.8rem rgb(0 0 0 / 0.35);
      font-size: 1.15rem;
    }

    .top[data-open] .top__nav {
      display: flex;
    }

    .top__nav a {
      padding-block: 0.85rem;
      border-bottom: 1px solid rgb(255 255 255 / 0.16);
      background: none;
    }

    .top__nav a:last-child {
      border-bottom: 0;
    }

    .top__nav a[aria-current='page'] {
      color: var(--foil);
    }
  }

  @media (max-width: 30rem) {
    .top__desc {
      display: none;
    }

    .top__cta span {
      display: none;
    }

    .top__cta {
      padding: 0.6rem;
      width: 2.9rem;
    }
  }

  @media (min-width: 56.01rem) {
    .top__nav a[aria-current='page'] {
      background-size: 100% 2px;
    }
  }
</style>

<script>
  const top = document.querySelector<HTMLElement>('.top')!;
  const btn = top.querySelector<HTMLButtonElement>('.top__menu')!;

  const setOpen = (open: boolean) => {
    top.toggleAttribute('data-open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
  };

  btn.addEventListener('click', () => setOpen(!top.hasAttribute('data-open')));
  top.querySelectorAll('.top__nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && top.hasAttribute('data-open')) {
      setOpen(false);
      btn.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!top.contains(e.target as Node)) setOpen(false);
  });
</script>
