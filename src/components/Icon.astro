---
// Ícones desenhados em um único traço (24px, stroke 2) para todo o site.
interface Props {
  name: 'whatsapp' | 'mail' | 'instagram' | 'arrow' | 'close' | 'check' | 'plus' | 'menu';
  label?: string;
}
const { name, label } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  {
    name === 'whatsapp' && (
      <>
        <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.3z" />
        <path d="M9 8.6c.2-.5.6-.6 1-.6.3 0 .5.2.6.5l.6 1.4c.1.3 0 .6-.2.8l-.5.5c.6 1.2 1.6 2.2 2.8 2.8l.5-.5c.2-.2.5-.3.8-.2l1.4.6c.3.1.5.3.5.6 0 .4-.1.8-.6 1-1.4.8-3.4.2-5.3-1.7S8.2 10 9 8.6z" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <path d="M17.2 6.8h.01" />
      </>
    )
  }
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
</svg>
