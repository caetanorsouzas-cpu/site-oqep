---
// Sobre nós: a história da agência, a fundadora (a figurinha brilhante) e o time.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/brand/logo.svg';
import { agency, team, founder, founderQuote, primaryContact } from '../data/site';

const teamFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/time/*.png', { eager: true });
const photoFor = (file?: string) => (file ? teamFiles[`../assets/time/${file}`]?.default : undefined);
const founderPhoto = photoFor(founder.photo);
---

<Base
  title="Sobre nós · O Que Eu Postaria?"
  description="Conheça a O Que Eu Postaria?: fundada em 2021 em Porto Alegre pela jornalista Andréia Ramires, e o time que cuida da comunicação dos nossos clientes."
>
  <Header current="sobre" />

  <main id="conteudo">
    <section class="page page--dark crew" aria-labelledby="crew-title">
      <div class="wrap">
        <h1 class="title crew__title" id="crew-title">Sobre nós</h1>

        <div class="founder">
          <div class="shiny" aria-hidden="true">
            <div class="shiny__photo">
              {
                founderPhoto ? (
                  <Image src={founderPhoto} alt="" widths={[300, 432]} sizes="(min-width: 48rem) 24rem, 17rem" quality={92} class="shiny__img" />
                ) : (
                  <>
                    <Image src={logo} alt="" width={160} height={160} class="shiny__mark" />
                    <span class="shiny__soon label">Foto em breve</span>
                  </>
                )
              }
            </div>
            <div class="shiny__plate">
              <span class="label shiny__num">OQEP 00</span>
              <span class="label shiny__name">Andréia Ramires</span>
              <span class="label shiny__role">Jornalista e fundadora</span>
            </div>
          </div>

          <div class="founder__text">
            <p class="founder__intro">
              A {agency.name} foi fundada em 8 de fevereiro de 2021, em Porto Alegre, pela jornalista <strong>Andréia Ramires</strong>.
            </p>
            <blockquote class="founder__quote">
              {founderQuote.map((p) => <p>{p}</p>)}
            </blockquote>
          </div>
        </div>

        <dl class="facts">
          <div>
            <dt class="label">Fundação</dt>
            <dd>{agency.founded}</dd>
          </div>
          <div>
            <dt class="label">Sede</dt>
            <dd>{agency.city}</dd>
          </div>
          <div>
            <dt class="label">Empresas e profissionais atendidos</dt>
            <dd>+75</dd>
          </div>
          <div>
            <dt class="label">Experiência em comunicação</dt>
            <dd>+8 anos</dd>
          </div>
        </dl>

        <h2 class="crew__sub label">Quem faz o que por aqui</h2>
        <ul class="team" role="list">
          {
            team.map((p, i) => (
              <li class="member">
                {photoFor(p.photo) ? (
                  <span class="member__slot member__slot--glued">
                    <Image src={photoFor(p.photo)!} alt={p.name} widths={[260, 400, 527]} sizes="(min-width: 90rem) 16rem, (min-width: 48rem) 19vw, 31vw" quality={92} />
                    <span class="member__no label" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  </span>
                ) : (
                <span class="member__slot" aria-hidden="true">
                  <span class="member__no label">{String(i + 1).padStart(2, '0')}</span>
                  <svg class="silhouette" viewBox="0 0 60 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 3">
                    <circle cx="30" cy="22" r="12" />
                    <path d="M8 62c0-13 10-21 22-21s22 8 22 21" />
                  </svg>
                </span>
                )}
                <span class="member__name label">{p.name}</span>
                <span class="member__role">{p.role}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="page page--terra talk" aria-labelledby="talk-title">
      <div class="wrap talk__in">
        <div>
          <h2 class="title talk__title" id="talk-title">Fale com o time</h2>
          <p class="talk__lead">Escolha com quem quer conversar. A gente entende o seu momento e prepara uma proposta para o seu negócio.</p>
        </div>
        <div class="talk__actions">
          <a class="btn btn--foil" href="/#contato">Ver contatos <Icon name="arrow" /></a>
          <a class="btn btn--line" href={primaryContact.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Crew */
  .crew {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .crew__title {
    font-size: clamp(3rem, 10vw, 8rem);
  }

  .founder {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  /* the one shiny sticker */
  .shiny {
    position: relative;
    padding: 0.6rem 0.6rem 0;
    border-radius: 0.9rem;
    background: radial-gradient(rgb(92 26 10 / 0.16) 1px, transparent 1.5px) 0 0 / 7px 7px, var(--foil);
    box-shadow: var(--shadow-lift);
    rotate: -3deg;
    color: var(--ink);
    max-width: 24rem;
  }

  .shiny__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    background:
      repeating-conic-gradient(from 0deg at 50% 45%, rgb(255 255 255 / 0.07) 0 6deg, transparent 6deg 12deg),
      var(--terra);
    overflow: hidden;
  }

  .shiny__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .shiny__mark {
    width: 48%;
    height: auto;
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--white);
  }

  .shiny__soon {
    position: absolute;
    bottom: 0.8rem;
    font-size: 0.8rem;
    color: var(--cream);
  }

  .shiny__plate {
    display: grid;
    padding: 0.7rem 0.3rem 0.8rem;
    line-height: 1.1;
  }

  .shiny__num {
    font-size: 0.78rem;
    color: var(--terra-dark);
  }

  .shiny__name {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .shiny__role {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--terra-dark);
  }

  .founder__intro {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 700;
    line-height: 1.3;
    max-width: 34ch;
  }

  .founder__quote {
    display: grid;
    gap: 1rem;
    margin-top: 1.6rem;
    padding-left: 1.4rem;
    border-left: 1px solid rgb(255 255 255 / 0.3);
    max-width: 64ch;
    color: var(--cream);
  }

  .founder__quote p:first-child::before {
    content: '“';
  }

  .founder__quote p:last-child::after {
    content: '”';
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 5rem);
    border-block: 1px solid rgb(255 255 255 / 0.25);
  }

  .facts > div {
    padding: 1.2rem 1rem 1.3rem 0;
  }

  .facts > div + div {
    padding-left: 1.2rem;
    border-left: 1px solid rgb(255 255 255 / 0.25);
  }

  .facts dt {
    font-size: 0.8rem;
    color: var(--cream);
  }

  .facts dd {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .crew__sub {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    font-size: 1rem;
    color: var(--foil);
  }

  .team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.6rem), 1fr));
    gap: 1.4rem 1rem;
    margin-top: 1.2rem;
  }

  .member {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .silhouette {
    width: 52%;
    color: rgb(255 255 255 / 0.4);
  }

  .member__slot {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: 0.6rem;
    border-radius: var(--radius-sticker);
    background: rgb(0 0 0 / 0.18);
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.22);
  }

  /* a member whose photo is in: the slot holds a glued sticker */
  .member__slot--glued {
    padding: 0.35rem;
    background: var(--white);
    box-shadow: var(--shadow-sticker);
    rotate: var(--tilt, -1.5deg);
  }

  .member:nth-child(even) .member__slot--glued {
    --tilt: 1.2deg;
  }

  /* Pinned inside the padding, so the photo can't stretch the slot past its aspect ratio */
  .member__slot--glued :global(img) {
    position: absolute;
    inset: 0.35rem;
    width: calc(100% - 0.7rem);
    height: calc(100% - 0.7rem);
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: calc(var(--radius-sticker) - 0.2rem);
  }

  .member__slot--glued .member__no {
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    background: var(--terra);
    color: var(--white);
  }

  .member__no {
    position: absolute;
    top: 0.5rem;
    left: 0.6rem;
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.55);
  }

  .member__name {
    font-size: 1rem;
    line-height: 1.15;
  }

  .member__role {
    font-size: 0.9rem;
    color: var(--cream);
    line-height: 1.3;
  }

  @media (max-width: 48rem) {
    .founder {
      grid-template-columns: 1fr;
    }

    .shiny {
      max-width: 17rem;
    }

    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .facts > div,
    .facts > div + div {
      padding: 1rem 0.8rem 1.1rem 0;
      border-left: 0;
    }

    .facts > div:nth-child(n + 3) {
      border-top: 1px solid rgb(255 255 255 / 0.25);
    }

    .team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.2rem 0.7rem;
    }

    .member__slot {
      aspect-ratio: 1;
    }

  }

  /* Closing call to the contact page */
  .talk {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .talk__in {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem 3rem;
  }

  .talk__title {
    font-size: clamp(2.4rem, 6vw, 5.4rem);
  }

  .talk__lead {
    margin-top: 1rem;
    max-width: 46ch;
    color: var(--cream);
  }

  .talk__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
</style>
