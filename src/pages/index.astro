---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Sticker from '../components/Sticker.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import Crests from '../components/Crests.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/brand/logo.svg';
import {
  agency,
  contacts,
  primaryContact,
  team,
  founderQuote,
  strategySteps,
  serviceGroups,
  portfolio,
  categories,
  testimonials,
} from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/portfolio/*.jpg', { eager: true });
const imageFor = (file: string) => {
  const mod = files[`../assets/portfolio/${file}`];
  if (!mod) throw new Error(`Imagem não encontrada: src/assets/portfolio/${file}`);
  return mod.default;
};

const works = await Promise.all(
  portfolio.map(async (w, i) => {
    const image = imageFor(w.file);
    const [thumb, full] = await Promise.all([
      getImage({ src: image, width: 520, format: 'webp' }),
      getImage({ src: image, width: 1600, format: 'webp' }),
    ]);
    return { ...w, image, number: i + 1, thumb: thumb.src, full: full.src };
  }),
);

const clientCount = new Set(
  portfolio
    .map((w) => w.client)
    .filter((c) => !['Estratégia digital', 'Ilustrações autorais', 'Cartazes', 'Backdrop', 'Papel timbrado', 'Cartões de visita', 'Sites e landing pages'].includes(c)),
).size;
const usedCategories = categories.filter((c) => portfolio.some((w) => w.category === c));

const worksJson = JSON.stringify(
  works.map(({ number, client, category, thumb, full }) => ({ number, client, category, thumb, full })),
);

// three real pieces fanned behind the sealed pack
const fan = [43, 7, 22].map((n) => works.find((w) => w.file.startsWith(String(n).padStart(2, '0')))!);
const serviceTotal = serviceGroups.reduce((n, g) => n + g.services.length, 0);
let serviceNo = 0;
---

<Base
  title="O Que Eu Postaria? · Agência de Comunicação e Marketing"
  description="Agência de comunicação e marketing de Porto Alegre para empresas e profissionais do Brasil inteiro. Estratégia antes do post: redes sociais, identidade visual, tráfego, assessoria de imprensa e sites."
>
  <Header />

  <main id="conteudo">
    <!-- Capa do álbum -->
    <section class="page page--terra hero" id="inicio" aria-labelledby="hero-title">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <h1 class="title hero__title" id="hero-title">
            O que eu <span class="hero__line">postaria?</span>
          </h1>
          <p class="hero__answer">A gente responde. Primeiro com estratégia, depois com o post.</p>
          <p class="hero__sub">
            Agência de comunicação e marketing de Porto Alegre (RS) para empresas e profissionais do Brasil inteiro.
          </p>
          <Newsletter id="hero" />
          <a class="hero__talk" href={primaryContact.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            Prefere conversar? Chama o {primaryContact.name.split(' ')[0]} no WhatsApp
          </a>
        </div>

        <div class="stage" data-stage>
          <div class="stage__fan" aria-hidden="true">
            {
              fan.map((w, i) => (
                <div class={`stage__fanned stage__fanned--${i + 1}`}>
                  <Sticker image={w.image} number={w.number} name={w.client} category={w.category} sizes="16rem" loading="eager" />
                </div>
              ))
            }
          </div>

          <button class="pack" type="button" data-pack aria-describedby="pack-hint">
            <span class="pack__strip" aria-hidden="true"></span>
            <span class="pack__body" aria-hidden="true">
              <Image src={logo} alt="" width={96} height={96} class="pack__logo" loading="eager" />
              <span class="pack__brand label">Figurinhas OQEP</span>
              <span class="pack__count title">5</span>
              <span class="pack__sub label">trabalhos reais</span>
            </span>
            <span class="visually-hidden">Abrir pacotinho de figurinhas</span>
          </button>

          <div class="stage__drop" data-drop aria-live="polite"></div>

          <p class="stage__hint" id="pack-hint" data-hint>
            <span data-hint-text>Abra o pacotinho: cada figurinha é um trabalho de verdade.</span>
            <button class="stage__again" type="button" data-again hidden>
              <Icon name="plus" /> Abrir outro
            </button>
          </p>
        </div>
      </div>
    </section>

    <!-- Estratégia antes do post -->
    <section class="page page--paper method" aria-labelledby="method-title">
      <div class="wrap method__grid">
        <div class="method__head">
          <h2 class="title method__title" id="method-title">Antes do post, a estratégia.</h2>
          <p class="method__lead">
            Todo trabalho começa entendendo a personalidade da sua empresa. Em 20 a 30 dias montamos a estratégia que guia cada publicação, e só depois
            partimos para a execução. Sem fórmula pronta: um plano de ação feito para o seu negócio.
          </p>
        </div>

        <ol class="phases" role="list">
          <li class="phase">
            <h3 class="phase__title">Estratégia</h3>
            <p>20 a 30 dias de estudo: canais, concorrência, personas, tom de voz e linhas editoriais.</p>
          </li>
          <li class="phase">
            <h3 class="phase__title">Execução</h3>
            <p>Redes, design, tráfego, imprensa e site seguindo o plano, com organização e prazos cumpridos.</p>
          </li>
          <li class="phase">
            <h3 class="phase__title">Parceria</h3>
            <p>Medimos o sucesso pelo tempo de parceria e pela confiança de quem trabalha com a gente.</p>
          </li>
        </ol>

        <div class="method__list">
          <h3 class="label method__listtitle">O que entra na estratégia</h3>
          <ul role="list" class="checks">
            {
              strategySteps.map((s) => (
                <li>
                  <Icon name="check" />
                  {s}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Álbum de trabalhos -->
    <section class="page page--terra album" id="album" aria-labelledby="album-title">
      <div class="wrap">
        <div class="album__head">
          <h2 class="title album__title" id="album-title">O álbum</h2>
          <p class="album__meta">
            <strong data-count>{works.length} figurinhas</strong>, {clientCount} clientes reais. Toque numa figurinha para ver o trabalho inteiro.
          </p>
        </div>

        <div class="filters" role="group" aria-label="Filtrar trabalhos">
          <button type="button" class="filter" aria-pressed="true" data-filter="*">Todas</button>
          {
            usedCategories.map((c) => (
              <button type="button" class="filter" aria-pressed="false" data-filter={c}>
                {c}
              </button>
            ))
          }
        </div>

        <ul class="slots" role="list" id="album-slots" data-slots>
          {
            works.map((w) => (
              <li class="slot" data-category={w.category} data-number={w.number} id={`figurinha-${w.number}`}>
                <span class="slot__print label" aria-hidden="true">
                  <span class="slot__printno">{String(w.number).padStart(2, '0')}</span>
                  {w.client}
                </span>
                <button class="slot__btn" type="button" data-open={w.number - 1} aria-label={`Ver ${w.category}: ${w.client}`}>
                  <Sticker image={w.image} number={w.number} name={w.client} category={w.category} />
                </button>
              </li>
            ))
          }
        </ul>

        <div class="album__more" data-more-wrap>
          <button type="button" class="btn btn--foil" data-more aria-controls="album-slots" aria-expanded="false">
            <Icon name="plus" /> Ver as {works.length} figurinhas
          </button>
        </div>

        <Crests />
      </div>
    </section>

    <!-- Lista de figurinhas: serviços -->
    <section class="page page--paper services" id="servicos" aria-labelledby="services-title">
      <div class="wrap services__grid">
        <div class="services__head">
          <h2 class="title services__title" id="services-title">Tudo o que a gente faz</h2>
          <p>
            {serviceTotal} serviços para cuidar da comunicação inteira, do posicionamento ao site. Você escolhe o que precisa; a gente prepara uma proposta para o
            seu momento.
          </p>
          <a class="btn btn--ink" href={primaryContact.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Pedir uma proposta
          </a>
        </div>

        <div class="checklist">
          {
            serviceGroups.map((g) => (
              <div class="checklist__group">
                <h3 class="checklist__title label">{g.title}</h3>
                <ul role="list">
                  {g.services.map((s) => {
                    serviceNo += 1;
                    return (
                      <li>
                        <details class="svc" open data-svc>
                          <summary class="svc__row">
                            <span class="svc__box" aria-hidden="true">
                              <Icon name="check" />
                            </span>
                            <span class="svc__no label">{String(serviceNo).padStart(2, '0')}</span>
                            <h4 class="svc__name">{s.name}</h4>
                            <span class="svc__more" aria-hidden="true">
                              <Icon name="plus" />
                            </span>
                          </summary>
                          <p class="svc__text">{s.text}</p>
                        </details>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- O time -->
    <section class="page page--dark crew" id="time" aria-labelledby="crew-title">
      <div class="wrap">
        <h2 class="title crew__title" id="crew-title">O time</h2>

        <div class="founder">
          <div class="shiny" aria-hidden="true">
            <div class="shiny__photo">
              <Image src={logo} alt="" width={160} height={160} class="shiny__mark" />
              <span class="shiny__soon label">Foto em breve</span>
            </div>
            <div class="shiny__plate">
              <span class="label shiny__num">OQEP 00</span>
              <span class="label shiny__name">Andréia Ramires</span>
              <span class="label shiny__role">Jornalista e fundadora</span>
            </div>
          </div>

          <div class="founder__text">
            <p class="founder__intro">
              A {agency.name} foi fundada em 8 de fevereiro de 2021, em Porto Alegre, pela jornalista <strong>Andréia Ramires</strong>.
            </p>
            <blockquote class="founder__quote">
              {founderQuote.map((p) => <p>{p}</p>)}
            </blockquote>
          </div>
        </div>

        <dl class="facts">
          <div>
            <dt class="label">Fundação</dt>
            <dd>{agency.founded}</dd>
          </div>
          <div>
            <dt class="label">Sede</dt>
            <dd>{agency.city}</dd>
          </div>
          <div>
            <dt class="label">Empresas e profissionais atendidos</dt>
            <dd>+75</dd>
          </div>
          <div>
            <dt class="label">Experiência em comunicação</dt>
            <dd>+8 anos</dd>
          </div>
        </dl>

        <h3 class="crew__sub label">Quem faz o que por aqui</h3>
        <ul class="team" role="list">
          {
            team.map((p, i) => (
              <li class="member">
                <span class="member__slot" aria-hidden="true">
                  <span class="member__no label">{String(i + 1).padStart(2, '0')}</span>
                  <svg class="silhouette" viewBox="0 0 60 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 3">
                    <circle cx="30" cy="22" r="12" />
                    <path d="M8 62c0-13 10-21 22-21s22 8 22 21" />
                  </svg>
                </span>
                <span class="member__name label">{p.name}</span>
                <span class="member__role">{p.role}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Depoimentos -->
    <section class="page page--terra words" aria-labelledby="words-title">
      <div class="wrap">
        <h2 class="title words__title" id="words-title">Feedbacks</h2>
        <div class="words__grid">
          {
            testimonials.map((t, i) => (
              <figure class={`word word--${i + 1}`}>
                <p class="word__hi">“{t.highlight}”</p>
                <blockquote class="word__full">
                  <p>{t.text}</p>
                </blockquote>
                <figcaption>
                  <span class="label word__name">{t.name}</span>
                  <span class="word__role">{t.role}</span>
                  <span class="label word__svc">{t.services}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contato -->
    <section class="page page--paper contact" id="contato" aria-labelledby="contact-title">
      <div class="wrap">
        <div class="contact__head">
          <h2 class="title contact__title" id="contact-title">Fale com o time</h2>
          <p>Escolha com quem quer conversar. A gente entende o seu momento e prepara uma proposta para o seu negócio.</p>
        </div>

        <ul class="people" role="list">
          {
            contacts.map((c, i) => (
              <li class="person">
                <div class="person__sticker">
                  <span class="person__band label" aria-hidden="true">OQEP C{i + 1}</span>
                  <span class="person__plate">
                    <span class="label person__name">{c.name}</span>
                    <span class="label person__role">{c.role}</span>
                  </span>
                </div>
                <a class="btn btn--ink person__wa" href={c.whatsapp} target="_blank" rel="noopener">
                  <Icon name="whatsapp" /> {c.phone}
                </a>
                <a class="person__mail" href={`mailto:${c.email}`}>
                  <Icon name="mail" />
                  <span>
                    {c.email.split('@')[0]}@<wbr />{c.email.split('@')[1]}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="contact__news">
          <Newsletter id="footer" tone="paper" />
          <a class="contact__ig" href={agency.instagram} target="_blank" rel="noopener">
            <Icon name="instagram" />
            <span>
              Siga <strong>{agency.instagramHandle}</strong>: foi lá que tudo começou, com dicas do que postar.
            </span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <dialog class="viewer" data-viewer aria-labelledby="viewer-title">
    <div class="viewer__in">
      <img class="viewer__img" data-viewer-img src={works[0].full} alt={`${works[0].category}: ${works[0].client}`} width="1600" height="1066" loading="lazy" />
      <div class="viewer__bar">
        <p class="viewer__cap">
          <span class="label viewer__no" data-viewer-no></span>
          <strong id="viewer-title" data-viewer-title></strong>
          <span data-viewer-cat></span>
        </p>
        <div class="viewer__nav">
          <button type="button" class="viewer__btn viewer__prev" data-viewer-prev aria-label="Figurinha anterior"><Icon name="arrow" /></button>
          <button type="button" class="viewer__btn" data-viewer-next aria-label="Próxima figurinha"><Icon name="arrow" /></button>
          <button type="button" class="viewer__btn" data-viewer-close aria-label="Fechar"><Icon name="close" /></button>
        </div>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="works-data" set:html={worksJson} />
</Base>

<style>
  /* Hero: album cover */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(4rem, 8vw, 7rem);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__title {
    font-size: clamp(2.9rem, 7.2vw, 7rem);
    letter-spacing: -0.03em;
  }

  .hero__line {
    display: block;
  }

  .hero__answer {
    margin-top: clamp(1.2rem, 2.5vw, 2rem);
    font-size: clamp(1.35rem, 2.3vw, 1.9rem);
    font-weight: 800;
    line-height: 1.2;
    max-width: 26ch;
    text-wrap: balance;
  }

  .hero__sub {
    margin-top: 0.8rem;
    margin-bottom: 1.8rem;
    max-width: 44ch;
    color: var(--terra-tint);
  }

  .hero__talk {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.2rem;
    font-weight: 700;
  }

  .hero__talk :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  /* Pack stage */
  .stage {
    position: relative;
    min-height: clamp(24rem, 42vw, 34rem);
    display: grid;
    place-items: center;
  }

  .stage__fan {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 0.4s var(--ease-out);
  }

  .stage__fanned {
    grid-area: 1 / 1;
    width: clamp(11rem, 19vw, 16rem);
  }

  .stage__fanned--1 {
    transform: translate(-48%, -22%) rotate(-14deg);
  }

  .stage__fanned--2 {
    transform: translate(46%, -30%) rotate(11deg);
  }

  .stage__fanned--3 {
    transform: translate(40%, 46%) rotate(-6deg);
  }

  .stage.is-open .stage__fan {
    opacity: 0;
    pointer-events: none;
  }

  .pack {
    position: relative;
    z-index: 2;
    width: clamp(11.5rem, 17vw, 14.5rem);
    aspect-ratio: 5 / 7;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform: rotate(-7deg);
    transition: transform 0.4s var(--ease-spring), filter 0.3s;
    filter: drop-shadow(0 1.2rem 1.4rem rgb(0 0 0 / 0.45));
    --crimp: conic-gradient(from -45deg at bottom, #000 90deg, #0000 0) 50% / 0.7rem 100%;
  }

  .pack:hover {
    transform: rotate(-3deg) translateY(-6px) scale(1.03);
  }

  .pack:focus-visible {
    outline-offset: 8px;
    border-radius: 0.5rem;
  }

  .pack__body,
  .pack__strip {
    position: absolute;
    inset-inline: 0;
    background:
      linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.35) 45%, transparent 58%) var(--sheen, 0%) 0 / 260% 100%,
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.05) 0 2px, transparent 2px 7px),
      linear-gradient(160deg, #f6cc45, #e0a520 55%, #f3c53b);
    transition: background-position 0.9s var(--ease-out);
  }

  .pack:hover .pack__body,
  .pack:hover .pack__strip {
    --sheen: 100%;
  }

  .pack__strip {
    top: 0;
    height: 14%;
    -webkit-mask:
      conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg) 50% 0 / 0.7rem 0.45rem repeat-x,
      linear-gradient(#000 0 0) 0 0.44rem / 100% 100% no-repeat;
    mask:
      conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg) 50% 0 / 0.7rem 0.45rem repeat-x,
      linear-gradient(#000 0 0) 0 0.44rem / 100% 100% no-repeat;
    border-bottom: 2px dashed rgb(92 26 10 / 0.35);
    transform-origin: 8% 100%;
  }

  .pack__body {
    top: 14%;
    bottom: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.35rem;
    padding: 1rem 0.8rem 1.4rem;
    color: var(--terra-dark);
    -webkit-mask:
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% 100% / 0.7rem 0.45rem repeat-x,
      linear-gradient(#000 0 0) 0 0 / 100% calc(100% - 0.44rem) no-repeat;
    mask:
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% 100% / 0.7rem 0.45rem repeat-x,
      linear-gradient(#000 0 0) 0 0 / 100% calc(100% - 0.44rem) no-repeat;
  }

  .pack__logo {
    width: 42%;
    height: auto;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--white), 0 0.4rem 0.8rem rgb(0 0 0 / 0.3);
  }

  .pack__brand {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  .pack__count {
    font-size: clamp(3.4rem, 5vw, 4.4rem);
    color: var(--terra);
    line-height: 0.85;
  }

  .pack__sub {
    font-size: 0.8rem;
  }

  .stage.is-open .pack {
    pointer-events: none;
  }

  .stage__drop {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stage__hint {
    position: absolute;
    bottom: -0.5rem;
    inset-inline: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.4rem 1rem;
    text-align: center;
    font-weight: 700;
    font-size: 0.95rem;
    z-index: 3;
  }

  .stage__again {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--white);
    color: var(--terra);
    font-weight: 800;
    cursor: pointer;
  }

  .stage__again :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .stage__again[hidden] {
    display: none;
  }

  /* stickers that fly out of the pack (built in JS) */
  :global(.flying) {
    position: absolute;
    left: 50%;
    top: 46%;
    width: clamp(9.5rem, 15vw, 12.5rem);
    margin: 0;
    padding: 0.35rem 0.35rem 0;
    border: 0;
    border-radius: var(--radius-sticker);
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-sticker);
    text-align: left;
    cursor: pointer;
    pointer-events: auto;
    transform: translate(-50%, -50%) translate(var(--x), var(--y)) rotate(var(--r));
    transition: box-shadow 0.25s;
  }

  :global(.flying:hover),
  :global(.flying:focus-visible) {
    z-index: 5;
    box-shadow: var(--shadow-lift);
  }

  :global(.flying img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.3rem;
  }

  :global(.flying__plate) {
    display: grid;
    margin: 0.35rem -0.35rem 0;
    padding: 0.45rem 0.55rem 0.5rem;
    background: var(--ink);
    color: var(--white);
    line-height: 1.15;
  }

  :global(.flying__no) {
    font-size: 0.7rem;
    color: var(--foil);
  }

  :global(.flying.is-glued::before) {
    content: 'Colada';
    position: absolute;
    top: -0.6rem;
    right: -0.5rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--foil);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.75rem;
    rotate: 6deg;
  }

  :global(.flying__name) {
    font-size: 0.82rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .stage {
      min-height: 25rem;
      margin-top: 1rem;
    }
  }

  /* Method */
  .method {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .method__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem) clamp(1rem, 3vw, 2.5rem);
  }

  .method__head {
    grid-column: 1 / span 7;
  }

  .method__title {
    font-size: clamp(2.4rem, 6vw, 5.4rem);
    color: var(--terra);
  }

  .method__lead {
    margin-top: 1.5rem;
    max-width: 58ch;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--ink-soft);
  }

  .phases {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 3px solid var(--ink);
  }

  .phase {
    padding: 1.4rem clamp(1rem, 2.5vw, 2rem) 0 0;
  }

  .phase + .phase {
    padding-left: clamp(1rem, 2.5vw, 2rem);
    border-left: 1px solid var(--paper-line);
  }

  .phase__title {
    margin: 0.3rem 0 0.6rem;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-stretch: 112%;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
  }

  .phase p {
    color: var(--ink-soft);
    max-width: 34ch;
  }

  .method__list {
    grid-column: 1 / -1;
    padding: clamp(1.4rem, 3vw, 2.4rem);
    background: var(--white);
    border-radius: 1rem;
    box-shadow: 0 0.1rem 0.2rem rgb(0 0 0 / 0.06), 0 1rem 2rem -1rem rgb(0 0 0 / 0.18);
  }

  .method__listtitle {
    font-size: 1rem;
    color: var(--terra);
    margin-bottom: 1.1rem;
  }

  .checks {
    columns: 3 16rem;
    column-gap: 2rem;
  }

  .checks li {
    display: flex;
    gap: 0.6rem;
    align-items: start;
    break-inside: avoid;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--paper-line);
    line-height: 1.35;
  }

  .checks :global(svg) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
    color: var(--terra);
    stroke-width: 3;
  }

  @media (max-width: 48rem) {
    .method__head {
      grid-column: 1 / -1;
    }

    .phases {
      grid-template-columns: 1fr;
    }

    .phase + .phase {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--paper-line);
      margin-top: 1.4rem;
    }
  }

  /* Album */
  .album {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .album__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 3rem;
  }

  .album__title {
    font-size: clamp(3rem, 10vw, 8rem);
  }

  .album__meta {
    max-width: 30ch;
    color: var(--terra-tint);
    font-size: 1.1rem;
  }

  .album__meta strong {
    color: var(--white);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 2.2rem 2.6rem;
  }

  .filter {
    padding: 0.55rem 1rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.5);
    color: var(--white);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .filter:hover {
    background: rgb(255 255 255 / 0.2);
  }

  .filter[aria-pressed='true'] {
    background: var(--white);
    color: var(--terra);
    box-shadow: none;
  }

  .slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: clamp(1rem, 2.2vw, 1.8rem);
  }

  .slot {
    position: relative;
    border-radius: var(--radius-sticker);
    background: var(--terra-deep);
    box-shadow: inset 0 0.15rem 0.5rem rgb(0 0 0 / 0.35);
  }

  .slot[hidden] {
    display: none;
  }

  .album__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .album__more[hidden] {
    display: none;
  }

  /* the slot's printed number and name, seen while the sticker drops in */
  .slot__print {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    padding: 1rem;
    color: rgb(255 255 255 / 0.4);
    font-size: 0.8rem;
  }

  .slot__print::before {
    content: '';
    position: absolute;
    inset: 0.7rem;
    border: 1.5px dashed rgb(255 255 255 / 0.35);
    border-radius: 0.35rem;
  }

  .slot.is-empty .slot__btn :global(.sticker) {
    opacity: 0;
  }

  .slot.is-empty .slot__btn {
    cursor: pointer;
  }

  .slot.is-empty .slot__btn:hover,
  .slot.is-empty .slot__btn:focus-visible {
    transform: none;
  }

  .slot.is-empty .slot__print {
    color: rgb(255 255 255 / 0.7);
  }

  .slot__printno {
    font-size: 2.6rem;
    font-stretch: 125%;
    font-weight: 900;
    line-height: 1;
  }

  .slot__btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    border-radius: var(--radius-sticker);
    text-align: left;
    cursor: zoom-in;
    rotate: var(--tilt, 0deg);
    transition: transform 0.35s var(--ease-spring), rotate 0.35s var(--ease-spring);
  }

  .slot:nth-child(3n + 1) .slot__btn {
    --tilt: -1.2deg;
  }

  .slot:nth-child(4n + 2) .slot__btn {
    --tilt: 1deg;
  }

  .slot:nth-child(5n + 3) .slot__btn {
    --tilt: 0.6deg;
  }

  .slot__btn:hover,
  .slot__btn:focus-visible {
    transform: translateY(-6px) scale(1.02);
    rotate: 0deg;
    --gloss: 0%;
  }

  .slot__btn:hover :global(.sticker),
  .slot__btn:focus-visible :global(.sticker) {
    box-shadow: var(--shadow-lift);
  }

  .slot.is-found .slot__btn {
    animation: found 1.1s var(--ease-out);
  }

  .slot.is-found::after {
    content: '';
    position: absolute;
    inset: -0.5rem;
    border-radius: 1rem;
    box-shadow: 0 0 0 3px var(--foil);
    animation: ring 1.6s var(--ease-out) forwards;
    pointer-events: none;
  }

  @keyframes found {
    0% {
      transform: scale(1.12) rotate(-3deg);
    }
    100% {
      transform: none;
    }
  }

  @keyframes ring {
    0%,
    60% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* Services checklist */
  .services {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .services__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .services__head {
    position: sticky;
    top: 6.5rem;
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }

  .services__title {
    font-size: clamp(2.4rem, 5.4vw, 4.8rem);
    color: var(--terra);
  }

  .services__head p {
    max-width: 40ch;
    color: var(--ink-soft);
    font-size: 1.1rem;
  }

  .checklist {
    display: grid;
    gap: 2.4rem;
  }

  .checklist__title {
    font-size: 0.95rem;
    color: var(--terra);
    padding-bottom: 0.5rem;
    border-bottom: 3px solid var(--ink);
  }

  .checklist ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .checklist ul {
    columns: 2 17rem;
    column-gap: 2rem;
  }

  .checklist li {
    break-inside: avoid;
  }

  .svc {
    padding-block: 1rem;
    border-bottom: 1px solid var(--paper-line);
  }

  .svc__row {
    display: grid;
    grid-template-columns: 1.6rem 1.9rem 1fr auto;
    gap: 0.75rem;
    align-items: start;
    list-style: none;
    pointer-events: none;
  }

  .svc__row::-webkit-details-marker {
    display: none;
  }

  /* the printed check square of an album checklist */
  .svc__box {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.05rem;
    border: 2px solid var(--ink);
    border-radius: 0.2rem;
    color: var(--terra);
  }

  .svc__box :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 3.2;
  }

  .svc__more {
    display: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--terra);
    transition: transform 0.3s var(--ease-out);
  }

  .svc__more :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 2.6;
  }

  .svc__no {
    padding-top: 0.25rem;
    color: var(--terra);
    font-size: 0.95rem;
  }

  .svc__name {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .svc__text {
    margin: 0.3rem 0 0 4.3rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  @media (max-width: 40rem) {
    .svc {
      padding-block: 0.8rem;
    }

    .svc__row {
      pointer-events: auto;
      cursor: pointer;
    }

    .svc__more {
      display: block;
    }

    .svc[open] .svc__more {
      transform: rotate(45deg);
    }
  }

  @media (max-width: 56rem) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    .services__head {
      position: static;
    }

  }

  /* Crew */
  .crew {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .crew__title {
    font-size: clamp(3rem, 10vw, 8rem);
  }

  .founder {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  /* the one shiny sticker */
  .shiny {
    position: relative;
    padding: 0.6rem 0.6rem 0;
    border-radius: 0.9rem;
    background: radial-gradient(rgb(92 26 10 / 0.16) 1px, transparent 1.5px) 0 0 / 7px 7px, var(--foil);
    box-shadow: var(--shadow-lift);
    rotate: -3deg;
    color: var(--ink);
    max-width: 24rem;
  }

  .shiny__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    background:
      repeating-conic-gradient(from 0deg at 50% 45%, rgb(255 255 255 / 0.07) 0 6deg, transparent 6deg 12deg),
      var(--terra);
    overflow: hidden;
  }

  .shiny__mark {
    width: 48%;
    height: auto;
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--white);
  }

  .shiny__soon {
    position: absolute;
    bottom: 0.8rem;
    font-size: 0.8rem;
    color: var(--terra-tint);
  }

  .shiny__plate {
    display: grid;
    padding: 0.7rem 0.3rem 0.8rem;
    line-height: 1.1;
  }

  .shiny__num {
    font-size: 0.78rem;
    color: var(--terra-dark);
  }

  .shiny__name {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .shiny__role {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--terra-dark);
  }

  .founder__intro {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 700;
    line-height: 1.3;
    max-width: 34ch;
  }

  .founder__quote {
    display: grid;
    gap: 1rem;
    margin-top: 1.6rem;
    padding-left: 1.4rem;
    border-left: 1px solid rgb(255 255 255 / 0.3);
    max-width: 64ch;
    color: var(--terra-tint);
  }

  .founder__quote p:first-child::before {
    content: '“';
  }

  .founder__quote p:last-child::after {
    content: '”';
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 5rem);
    border-block: 1px solid rgb(255 255 255 / 0.25);
  }

  .facts > div {
    padding: 1.2rem 1rem 1.3rem 0;
  }

  .facts > div + div {
    padding-left: 1.2rem;
    border-left: 1px solid rgb(255 255 255 / 0.25);
  }

  .facts dt {
    font-size: 0.8rem;
    color: var(--terra-tint);
  }

  .facts dd {
    margin-top: 0.2rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 900;
    font-stretch: 112%;
    font-variant-numeric: tabular-nums;
  }

  .crew__sub {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    font-size: 1rem;
    color: var(--foil);
  }

  .team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.6rem), 1fr));
    gap: 1.4rem 1rem;
    margin-top: 1.2rem;
  }

  .member {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .silhouette {
    width: 52%;
    color: rgb(255 255 255 / 0.4);
  }

  .member__slot {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: 0.6rem;
    border-radius: var(--radius-sticker);
    background: rgb(0 0 0 / 0.18);
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.22);
  }

  .member__no {
    position: absolute;
    top: 0.5rem;
    left: 0.6rem;
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.55);
  }

  .member__name {
    font-size: 1rem;
    line-height: 1.15;
  }

  .member__role {
    font-size: 0.9rem;
    color: var(--terra-tint);
    line-height: 1.3;
  }

  @media (max-width: 48rem) {
    .founder {
      grid-template-columns: 1fr;
    }

    .shiny {
      max-width: 17rem;
    }

    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .facts > div,
    .facts > div + div {
      padding: 1rem 0.8rem 1.1rem 0;
      border-left: 0;
    }

    .facts > div:nth-child(n + 3) {
      border-top: 1px solid rgb(255 255 255 / 0.25);
    }

    .team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.2rem 0.7rem;
    }

    .member__slot {
      aspect-ratio: 1;
    }

  }

  /* Testimonials */
  .words {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .words__title {
    font-size: clamp(2.4rem, 6.5vw, 6rem);
    max-width: 12ch;
  }

  .words__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .word {
    display: grid;
    gap: 1.2rem;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    background: var(--white);
    color: var(--ink);
    border-radius: 1rem;
    box-shadow: var(--shadow-sticker);
  }

  .word:nth-child(odd) {
    rotate: -1deg;
  }

  .word:nth-child(even) {
    rotate: 1.2deg;
    margin-top: clamp(0rem, 6vw, 5rem);
  }

  .word__hi {
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 900;
    font-stretch: 108%;
    line-height: 1.12;
    color: var(--terra);
    text-wrap: balance;
  }

  .word__full {
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .word figcaption {
    display: grid;
    gap: 0.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--paper-line);
  }

  .word__name {
    font-size: 1.05rem;
  }

  .word__role {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .word__svc {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    color: var(--terra);
  }

  @media (max-width: 48rem) {
    .words__grid {
      grid-template-columns: 1fr;
    }

    .word:nth-child(even) {
      margin-top: 0;
    }
  }

  /* Contact */
  .contact {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .contact__head {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .contact__title {
    font-size: clamp(2.6rem, 7vw, 6.4rem);
    color: var(--terra);
  }

  .contact__head p {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 50ch;
  }

  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17.5rem), 1fr));
    gap: 2rem 1.25rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .person {
    display: grid;
    align-content: start;
    gap: 0.7rem;
  }

  .person__sticker {
    padding: 0.45rem 0.45rem 0;
    border-radius: var(--radius-sticker);
    background: var(--white);
    box-shadow: var(--shadow-sticker);
    overflow: hidden;
    rotate: var(--tilt, 0deg);
  }

  .person:nth-child(odd) .person__sticker {
    --tilt: -1deg;
  }

  .person:nth-child(even) .person__sticker {
    --tilt: 0.8deg;
  }

  .person__band {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: calc(var(--radius-sticker) - 0.25rem) calc(var(--radius-sticker) - 0.25rem) 0 0;
    background: var(--terra);
    color: var(--terra-tint);
    font-size: 0.75rem;
  }

  .person__plate {
    display: grid;
    margin: 0 -0.45rem 0;
    padding: 0.55rem 0.75rem 0.65rem;
    background: var(--ink);
    color: var(--white);
    line-height: 1.15;
  }

  .person__name {
    font-size: 1.2rem;
  }

  .person__role {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--foil);
  }

  .person__wa {
    justify-self: start;
    font-variant-numeric: tabular-nums;
    min-height: 2.9rem;
    padding: 0.6rem 1.1rem;
    font-size: 0.95rem;
  }

  .person__mail {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    font-stretch: 88%;
    color: var(--ink-soft);
  }

  @media (min-width: 64rem) {
    .person__mail span {
      white-space: nowrap;
    }
  }

  .person__mail :global(svg) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
  }

  .contact__news {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: end;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 3px solid var(--ink);
  }

  .contact__ig {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    font-size: 1.05rem;
    text-decoration: none;
    max-width: 40ch;
  }

  .contact__ig :global(svg) {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    color: var(--terra);
  }

  .contact__ig:hover strong {
    text-decoration: underline;
  }

  @media (max-width: 48rem) {
    .contact__news {
      grid-template-columns: 1fr;
    }
  }

  /* Viewer */
  .viewer {
    width: min(100% - 2rem, 76rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    border-radius: 1rem;
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 2rem 4rem -1rem rgb(0 0 0 / 0.6);
    overflow: hidden;
  }

  .viewer::backdrop {
    background: rgb(40 10 2 / 0.78);
  }

  .viewer[open] {
    animation: viewer-in 0.45s var(--ease-out);
  }

  @keyframes viewer-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem) scale(0.96) rotate(-1deg);
    }
  }

  .viewer__in {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    max-height: calc(100dvh - 2rem);
  }

  .viewer__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    background: var(--terra);
  }

  .viewer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem 0.9rem 1.3rem;
  }

  .viewer__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.8rem;
  }

  .viewer__no {
    padding: 0.15rem 0.45rem;
    border-radius: 0.3rem;
    background: var(--terra);
    color: var(--white);
    font-size: 0.8rem;
  }

  .viewer__cap span:last-child {
    color: var(--terra);
    font-weight: 700;
  }

  .viewer__nav {
    display: flex;
    gap: 0.4rem;
  }

  .viewer__btn {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .viewer__btn:hover {
    background: var(--ink);
    color: var(--white);
  }

  .viewer__btn :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .viewer__prev :global(svg) {
    transform: scaleX(-1);
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer[open],
    .slot.is-found .slot__btn {
      animation: none;
    }
  }
</style>

<script>
  type Work = { number: number; client: string; category: string; thumb: string; full: string };
  const works: Work[] = JSON.parse(document.getElementById('works-data')!.textContent || '[]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const spring = getComputedStyle(document.documentElement).getPropertyValue('--ease-spring').trim() || 'ease-out';
  const pad = (n: number) => String(n).padStart(2, '0');

  /* ---------- Services: descriptions open on wide screens, tap to open on phones ---------- */
  if (matchMedia('(max-width: 40rem)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('[data-svc]').forEach((d) => (d.open = false));
  }
  document.querySelectorAll<HTMLElement>('.svc__row').forEach((sum) =>
    sum.addEventListener('click', (e) => {
      if (!matchMedia('(max-width: 40rem)').matches) e.preventDefault();
    }),
  );

  /* ---------- Album filter ---------- */
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const slots = document.querySelectorAll<HTMLLIElement>('.slot');

  const moreWrap = document.querySelector<HTMLElement>('[data-more-wrap]')!;
  const more = moreWrap.querySelector<HTMLButtonElement>('[data-more]')!;
  const PREVIEW = 12;
  let expanded = false;

  function applyFilter(value: string) {
    filters.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === value)));
    const collapse = value === '*' && !expanded;
    slots.forEach((s, i) => {
      s.hidden = (value !== '*' && s.dataset.category !== value) || (collapse && i >= PREVIEW);
    });
    moreWrap.hidden = !collapse;
  }
  applyFilter('*');

  /* ---------- Empty slots: the first pack holds the stickers the album is missing ---------- */
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const missing = new Set<number>();
  function updateCount() {
    const glued = works.length - missing.size;
    count.textContent = missing.size ? `${glued} de ${works.length} figurinhas coladas` : `${works.length} figurinhas coladas`;
  }
  if (!reduce) {
    const pool = [...Array(Math.min(PREVIEW, works.length)).keys()].sort(() => Math.random() - 0.5).slice(0, 5);
    pool.forEach((i) => {
      missing.add(i);
      const slot = slots[i];
      slot.classList.add('is-empty');
      slot.querySelector('.slot__btn')!.setAttribute('aria-label', `Colar a figurinha ${pad(works[i].number)}: ${works[i].client}`);
    });
    updateCount();
  }

  function glue(i: number) {
    if (!missing.has(i)) return false;
    missing.delete(i);
    const slot = slots[i];
    const btn = slot.querySelector<HTMLButtonElement>('.slot__btn')!;
    slot.classList.remove('is-empty');
    btn.setAttribute('aria-label', `Ver ${works[i].category}: ${works[i].client}`);
    btn.animate(
      [
        { transform: 'translate(0.5rem, -3rem) rotate(-9deg) scale(1.3)', opacity: 0 },
        { opacity: 1, offset: 0.3 },
        { transform: 'none', opacity: 1 },
      ],
      { duration: 700, easing: spring },
    );
    document.querySelectorAll<HTMLElement>(`.flying[data-work="${i}"]`).forEach((f) => f.classList.add('is-glued'));
    updateCount();
    return true;
  }

  more.addEventListener('click', () => {
    expanded = true;
    more.setAttribute('aria-expanded', 'true');
    applyFilter('*');
    slots[PREVIEW]?.querySelector<HTMLButtonElement>('.slot__btn')?.focus();
  });
  filters.forEach((b) => b.addEventListener('click', () => applyFilter(b.dataset.filter!)));

  /* ---------- Stickers drop into their slots on first sight ---------- */
  if (!reduce && 'IntersectionObserver' in window) {
    const fold = innerHeight;
    const pending = [...document.querySelectorAll<HTMLElement>('.slot__btn')].filter((el) => el.getBoundingClientRect().top > fold);
    pending.forEach((el) => (el.style.opacity = '0'));
    let batch: HTMLElement[] = [];
    let timer = 0;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          batch.push(e.target as HTMLElement);
        });
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          batch.forEach((el, i) => {
            const turn = (i % 2 ? 1 : -1) * (6 + (i % 3) * 3);
            el.animate(
              [
                { opacity: 0, transform: `translate(1.5rem, 4rem) rotate(${turn}deg) scale(1.25)` },
                { opacity: 1, transform: 'none' },
              ],
              { duration: 650, delay: i * 70, easing: spring, fill: 'backwards' },
            );
            el.style.opacity = '';
          });
          batch = [];
        }, 40);
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    pending.forEach((el) => io.observe(el));
  }

  /* ---------- Viewer ---------- */
  const viewer = document.querySelector<HTMLDialogElement>('[data-viewer]')!;
  const vImg = viewer.querySelector<HTMLImageElement>('[data-viewer-img]')!;
  const vNo = viewer.querySelector<HTMLElement>('[data-viewer-no]')!;
  const vTitle = viewer.querySelector<HTMLElement>('[data-viewer-title]')!;
  const vCat = viewer.querySelector<HTMLElement>('[data-viewer-cat]')!;
  let current = 0;

  function visibleIndexes() {
    return [...slots].filter((s) => !s.hidden).map((s) => Number(s.dataset.number) - 1);
  }

  function show(i: number) {
    const w = works[i];
    current = i;
    vImg.src = w.full;
    vImg.alt = `${w.category}: ${w.client}`;
    vNo.textContent = `OQEP ${pad(w.number)}`;
    vTitle.textContent = w.client;
    vCat.textContent = w.category;
  }

  function step(dir: number) {
    const list = visibleIndexes();
    const at = list.indexOf(current);
    show(list[(at + dir + list.length) % list.length]);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => {
      const i = Number(b.dataset.open);
      if (glue(i)) return;
      show(i);
      viewer.showModal();
    }),
  );
  viewer.querySelector('[data-viewer-close]')!.addEventListener('click', () => viewer.close());
  viewer.querySelector('[data-viewer-prev]')!.addEventListener('click', () => step(-1));
  viewer.querySelector('[data-viewer-next]')!.addEventListener('click', () => step(1));
  viewer.addEventListener('click', (e) => {
    if (e.target === viewer) viewer.close();
  });
  viewer.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });

  /* ---------- The pack ---------- */
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const pack = stage.querySelector<HTMLButtonElement>('[data-pack]')!;
  const strip = pack.querySelector<HTMLElement>('.pack__strip')!;
  const drop = stage.querySelector<HTMLElement>('[data-drop]')!;
  const again = stage.querySelector<HTMLButtonElement>('[data-again]')!;
  const hintText = stage.querySelector<HTMLElement>('[data-hint-text]')!;
  let deck: number[] = [];

  function draw(n: number) {
    if (missing.size) {
      const picks = [...missing];
      const rest = works.map((_, i) => i).filter((i) => !missing.has(i)).sort(() => Math.random() - 0.5);
      return [...picks, ...rest].slice(0, n);
    }
    if (deck.length < n) {
      deck = works.map((_, i) => i).sort(() => Math.random() - 0.5);
    }
    return deck.splice(0, n);
  }

  function fanSpots() {
    const w = stage.clientWidth;
    const sx = Math.min(w * 0.3, 190);
    return [
      { x: -sx, y: -95, r: -12 },
      { x: sx * 0.95, y: -110, r: 9 },
      { x: 0, y: -10, r: -3 },
      { x: -sx * 0.85, y: 95, r: 7 },
      { x: sx * 0.9, y: 90, r: -9 },
    ];
  }

  function findInAlbum(i: number) {
    expanded = true;
    more.setAttribute('aria-expanded', 'true');
    applyFilter('*');
    const slot = document.getElementById(`figurinha-${works[i].number}`)!;
    slot.classList.remove('is-found');
    slot.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    void slot.offsetWidth;
    slot.classList.add('is-found');
    slot.querySelector<HTMLButtonElement>('.slot__btn')!.focus({ preventScroll: true });
    window.setTimeout(() => glue(i), reduce ? 0 : 550);
    window.setTimeout(() => slot.classList.remove('is-found'), 1800);
  }

  function spawn(indexes: number[]) {
    drop.replaceChildren();
    const spots = fanSpots();
    indexes.forEach((wi, k) => {
      const w = works[wi];
      const s = spots[k];
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'flying';
      b.style.setProperty('--x', `${s.x}px`);
      b.style.setProperty('--y', `${s.y}px`);
      b.style.setProperty('--r', `${s.r}deg`);
      b.dataset.work = String(wi);
      if (!missing.has(wi)) b.classList.add('is-glued');
      b.setAttribute('aria-label', missing.has(wi) ? `${w.client}, ${w.category}. Colar no álbum` : `${w.client}, ${w.category}. Achar no álbum`);
      b.innerHTML = `<img src="${w.thumb}" alt="" width="520" height="347" decoding="async"><span class="flying__plate"><span class="label flying__no">OQEP ${pad(w.number)} · ${w.category}</span><span class="label flying__name"></span></span>`;
      b.querySelector('.flying__name')!.textContent = w.client;
      b.addEventListener('click', () => findInAlbum(wi));
      drop.append(b);
      if (!reduce) {
        b.animate(
          [
            { transform: `translate(-50%, -50%) translate(0px, 20px) rotate(${s.r * -2}deg) scale(0.4)`, opacity: 0 },
            { opacity: 1, offset: 0.25 },
            { transform: `translate(-50%, -50%) translate(${s.x}px, ${s.y}px) rotate(${s.r}deg) scale(1)`, opacity: 1 },
          ],
          { duration: 800, delay: 120 + k * 90, easing: spring, fill: 'backwards' },
        );
      }
    });
  }

  async function open() {
    stage.classList.add('is-open');
    pack.setAttribute('aria-expanded', 'true');
    const picks = draw(5);
    if (!reduce) {
      await strip.animate(
        [
          { transform: 'none' },
          { transform: 'translate(10%, -60%) rotate(-24deg)', opacity: 1, offset: 0.6 },
          { transform: 'translate(40%, -180%) rotate(-40deg)', opacity: 0 },
        ],
        { duration: 450, easing: 'cubic-bezier(.3,.7,.4,1)', fill: 'forwards' },
      ).finished;
      pack.animate(
        [
          { transform: 'rotate(-7deg)' },
          { transform: 'rotate(-4deg) translateY(30%) scale(.9)', opacity: 0 },
        ],
        { duration: 420, easing: 'cubic-bezier(.5,0,.75,0)', fill: 'forwards' },
      );
    } else {
      pack.style.opacity = '0';
    }
    spawn(picks);
    hintText.textContent = missing.size ? 'Toque numa figurinha para colar no álbum.' : 'Toque numa figurinha para achar o trabalho no álbum.';
    again.hidden = false;
  }

  if (missing.size) hintText.textContent = `Abra o pacotinho: faltam ${missing.size} figurinhas no álbum.`;
  pack.addEventListener('click', open);
  again.addEventListener('click', () => {
    const picks = draw(5);
    if (reduce) return spawn(picks);
    const old = [...drop.children] as HTMLElement[];
    Promise.all(
      old.map((el, i) =>
        el.animate([{ opacity: 1 }, { opacity: 0, transform: `${el.style.transform} translateY(40px)` }], {
          duration: 220,
          delay: i * 30,
          fill: 'forwards',
        }).finished,
      ),
    ).then(() => spawn(picks));
  });
</script>
